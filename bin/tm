#!/bin/bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  tm -c <name>    Create or attach to session
  tm a            Attach to most recent session
  tm -r <name>    Remove session
  tm -r --all     Remove all sessions
  tm ls           List sessions
USAGE
}

# tmux-resurrect の保存先を本体(helpers.sh)と同じロジックで解決する。
# ~/.tmux/resurrect が既にあればそれを、なければ XDG (~/.local/share/tmux/resurrect) を使う。
resurrect_dir() {
  if [ -d "$HOME/.tmux/resurrect" ]; then
    echo "$HOME/.tmux/resurrect"
  else
    echo "${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect"
  fi
}

case "${1:-}" in
  -c)
    if [ -z "${2:-}" ]; then
      echo "Error: session name required"
      usage
      exit 1
    fi
    tmux new -A -s "$2"
    ;;
  -r)
    if [ "${2:-}" = "--all" ]; then
      tmux kill-server 2>/dev/null && echo "All sessions removed" || echo "No sessions"
      rm -f "$(resurrect_dir)/last"
      echo "Resurrect snapshot cleared"
    elif [ -n "${2:-}" ]; then
      tmux kill-session -t "$2" && echo "Session '$2' removed"
    else
      echo "Error: session name or --all required"
      usage
      exit 1
    fi
    ;;
  a)
    if tmux attach 2>/dev/null; then
      :
    elif [ -f "$(resurrect_dir)/last" ]; then
      echo "Restoring from resurrect snapshot..."
      tmux new-session -d -s _restore_tmp
      tmux run-shell ~/.tmux/plugins/tmux-resurrect/scripts/restore.sh
      sleep 1
      tmux kill-session -t _restore_tmp 2>/dev/null
      tmux attach
    else
      echo "No sessions and no resurrect snapshot"
      exit 1
    fi
    ;;
  ls)
    tmux ls 2>/dev/null || echo "No sessions"
    ;;
  *)
    usage
    ;;
esac
